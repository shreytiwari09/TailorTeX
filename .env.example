# Optional. Every setting here can also be left empty.

# A model key the server uses for everyone who doesn't paste their own.
# Leave empty to make each user bring their own key (recommended for public deployments).
TAILORTEX_API_KEY=
# Provider for the key above: openai, anthropic, google, groq, mistral, deepseek or openrouter.
# Leave empty to detect it from the key.
TAILORTEX_PROVIDER=
# Model id for the key above. Leave empty to use the provider's recommended model.
TAILORTEX_MODEL=

# Folder containing pdflatex / xelatex, if it isn't on PATH or in a standard TinyTeX location.
TAILORTEX_TEX_BIN=
# Install missing LaTeX packages with tlmgr on first use (local TinyTeX only).
TAILORTEX_TEX_AUTOINSTALL=1

# Where learning data (bandit statistics, style memory) is kept.
TAILORTEX_DATA_DIR=data

# --- Accounts and storage (optional; without DATABASE_URL the app runs in guest mode only) ---
# PostgreSQL with the pgvector extension. `docker compose up -d db` starts one locally.
DATABASE_URL=postgresql+asyncpg://tailortex:tailortex@localhost:5432/tailortex
# Encrypts users' saved model keys. Use a long random string and keep it: changing it makes saved keys unreadable.
APP_SECRET=
# Sign-in uses Firebase Authentication (Google and email link). Copy these from Firebase console ->
# Project settings -> General -> Your apps -> Web app -> firebaseConfig. They are public identifiers, not secrets.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
